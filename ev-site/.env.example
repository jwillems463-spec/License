# EV Catalog — environment configuration
# Copy to ".env" ONLY if you are not using config.php (config.php wins if both exist).

APP_NAME="EV Catalog"
APP_URL=https://example.com
# Leave empty for domain root; "/ev" if installed in public_html/ev
APP_BASE_PATH=
APP_DEBUG=false
APP_TIMEZONE=UTC

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_evcatalog
DB_USERNAME=cpaneluser_evuser
DB_PASSWORD=CHANGE_ME

SESSION_NAME=evcatalog_session
SESSION_LIFETIME=7200

UPLOAD_MAX_BYTES=5242880
